{
  "name": "dsh-mini-kit",
  "version": "0.1.0",
  "description": "Two small DeepSeek Harness utilities: restart the desktop app and continue the sessions that were running, and list what is running right now.",
  "type": "module",
  "license": "MIT",
  "author": "Ckarefulon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ckarefulon/dsh-mini-kit.git"
  },
  "homepage": "https://github.com/Ckarefulon/dsh-mini-kit#readme",
  "bugs": {
    "url": "https://github.com/Ckarefulon/dsh-mini-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node test/all.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "sessions"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "meta": {
    "title": "Mini Kit",
    "description": "Restart the app and continue the sessions that were running, and list what is running now."
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
